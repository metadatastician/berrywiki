#
# berrywiki.launcher.a2ml — per-app launcher config for BerryWiki.
# Compliant with launcher-standard.a2ml v0.3.0
#
# BerryWiki: Companion authoring layer for GitHub Wikis

[project]
name         = "berrywiki"
display      = "BerryWiki"
description  = "Companion authoring, navigation, indexing and synchronisation layer for GitHub.com Wikis"
categories   = ["Development", "Documentation", "Utility"]
version      = "0.0.1"
license      = "MPL-2.0"

[repo]
# NOTE: repo-dir is resolved at runtime from the launcher script location.
# Do NOT hardcode absolute paths. Leave empty or use relative paths.
path = ""

[runtime]
# BerryWiki CLI is a process-based application
kind = "process"
startup-command-search = [
    "{repo-dir}/target/release/berrywiki-cli",
    "{repo-dir}/crates/berrywiki-cli/target/release/berrywiki-cli",
    "berrywiki-cli",
]
# Per launcher-standard.a2ml [runtime] section:
# PID files MUST use XDG_RUNTIME_DIR or TMPDIR, NEVER /tmp directly
# Log files MUST use XDG_STATE_HOME, NEVER /tmp directly
pid-file = "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/berrywiki.pid"
log-file = "${XDG_STATE_HOME:-$HOME/.local/state}/berrywiki/berrywiki.log"
wait-for-url-timeout-seconds = 10

[version-output]
# Per launcher-standard.a2ml [version-output] section
first-line-format = "berrywiki {version} ({build-sha-short}) [{platform}]"
example = "berrywiki 0.0.1 (abc1234) [linux-x86_64]"
exit-code = 0

[icon]
source = "{repo-dir}/assets/icon-256.png"
